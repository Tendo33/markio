# ============================================================================
# Markio 配置文件示例
# 复制此文件为 .env 并根据需要修改配置
# ============================================================================

# ----------------------------------------------------------------------------
# PDF 解析引擎配置
# ----------------------------------------------------------------------------

# PDF解析引擎选择
# - pipeline: MinerU传统管道引擎（推荐，自动选择OCR/VLM）
# - vlm-vllm-engine: 本地vLLM引擎（需要GPU，高性能）
# - vlm-vllm-client: 远程vLLM客户端（需要配置VLM_SERVER_URL）
PDF_PARSE_ENGINE="pipeline"

# VLM服务器URL（仅在使用vlm-vllm-client时需要）
# 示例: http://localhost:30000
# VLM_SERVER_URL=""

# ----------------------------------------------------------------------------
# MinerU 引擎配置
# ----------------------------------------------------------------------------

# MinerU设备模式 - 指定推理计算设备类型
# - cuda: 使用NVIDIA GPU加速（推荐，需要CUDA支持）
# - cpu: 使用CPU进行计算（较慢但兼容性更好）
# - mps: 使用Apple Silicon GPU加速（Mac M系列芯片）
MINERU_DEVICE_MODE="cuda"

# MinerU最小批处理推理大小
# 批量处理时的最小样本数量
# - 较大的值可以提高GPU利用率，但会增加内存使用
# - GPU推荐: 256-512
# - CPU推荐: 64-128
MINERU_MIN_BATCH_INFERENCE_SIZE=256

# MinerU模型来源 - 指定模型加载方式
# - local: 从本地文件系统加载模型（推荐）
# - huggingface: 从HuggingFace下载
# - modelscope: 从ModelScope下载
MINERU_MODEL_SOURCE="local"

# MinerU虚拟显存大小（MB）
# 仅在使用pipeline引擎时有效
# 根据GPU实际显存大小调整:
# - 8GB GPU: 8192
# - 16GB GPU: 16384
# - 24GB GPU: 24576
# - CPU模式: 4096
MINERU_VIRTUAL_VRAM_SIZE=8192

# ----------------------------------------------------------------------------
# vLLM 配置（仅在使用vlm-vllm-engine或vlm-vllm-client时需要）
# ----------------------------------------------------------------------------

# vLLM GPU显存利用率
# 控制vLLM引擎使用的GPU显存比例（0.0-1.0）
# vLLM会预分配指定比例的GPU显存
# - 高性能: 0.9 (默认，推荐)
# - 平衡: 0.8
# - 保守: 0.7
# 注意: 设置过高可能导致OOM，设置过低会影响性能
VLM_GPU_MEMORY_UTILIZATION=0.9

# ----------------------------------------------------------------------------
# 输出和日志配置
# ----------------------------------------------------------------------------

# 解析内容输出目录
OUTPUT_DIR="outputs"

# 日志文件目录
LOG_DIR="logs"

# 日志级别
# DEBUG: 详细调试信息
# INFO: 一般信息（推荐）
# WARNING: 警告信息
# ERROR: 仅错误信息
LOG_LEVEL="INFO"

# ----------------------------------------------------------------------------
# 服务配置
# ----------------------------------------------------------------------------

# 服务监听地址
# - 0.0.0.0: 允许外部访问
# - 127.0.0.1: 仅本地访问
HOST="0.0.0.0"

# 服务端口
PORT=8000

# ----------------------------------------------------------------------------
# CORS 配置（默认同源，跨域需显式白名单）
# ----------------------------------------------------------------------------

# 逗号分隔白名单（为空表示不放行跨域）
# CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# 是否允许携带凭证（Cookie/Authorization）
CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------------------------------------------
# 鉴权配置（/v1 全部接口）
# ----------------------------------------------------------------------------

# JWT密钥（必填，生产环境请使用高强度随机字符串）
AUTH_JWT_SECRET=""

# JWT算法（当前仅支持 HS256）
AUTH_JWT_ALGORITHM="HS256"

# ----------------------------------------------------------------------------
# SDK / CLI / Gradio 远程访问配置（可选）
# ----------------------------------------------------------------------------

# 远程API基础地址（启用 SDK/CLI 远程模式时使用）
# MARKIO_API_BASE_URL="http://localhost:8000"

# 远程 API 前缀（Gradio 使用，默认 /v1）
# MARKIO_API_PREFIX="/v1"

# 远程 API 文档地址（Gradio 健康检查与帮助链接使用）
# MARKIO_API_DOCS_URL="http://localhost:8000/docs"

# 远程API Bearer Token（SDK/CLI/Gradio 会自动附带 Authorization 头）
# MARKIO_API_TOKEN=""

# ----------------------------------------------------------------------------
# 高级配置
# ----------------------------------------------------------------------------

# 启用MCP服务器（实验性功能）
# ENABLE_MCP=false

# ----------------------------------------------------------------------------
# Redis 缓存配置
# ----------------------------------------------------------------------------

# 启用Redis功能
# true: 启用Redis缓存和相关功能
# false: 禁用Redis（默认）
REDIS_ENABLED=false

# Redis服务器地址
# - localhost: 本地Redis服务
# - redis: Docker Compose服务名
# - IP地址: 远程Redis服务器
REDIS_HOST="localhost"

# Redis服务器端口（默认6379）
REDIS_PORT=6379

# Redis数据库索引（0-15）
# 不同的应用可以使用不同的数据库索引来隔离数据
REDIS_DB=0

# Redis密码（生产环境强烈建议必填）
# compose.yaml 使用 requirepass，请保持两端一致
# REDIS_PASSWORD="change_me_to_a_strong_secret"

# Redis连接池最大连接数
# 根据应用并发量调整:
# - 低并发: 10-20
# - 中并发: 30-50（默认）
# - 高并发: 100+
REDIS_MAX_CONNECTIONS=50

# Redis Socket超时时间（秒）
# 执行Redis命令的超时时间
REDIS_SOCKET_TIMEOUT=5

# Redis连接超时时间（秒）
# 建立Redis连接的超时时间
REDIS_SOCKET_CONNECT_TIMEOUT=5

# 默认缓存过期时间（秒）
# 缓存项的默认TTL（Time To Live）
# - 1小时: 3600（默认）
# - 1天: 86400
# - 1周: 604800
REDIS_DEFAULT_TTL=3600

# ----------------------------------------------------------------------------
# 异步任务系统配置
# ----------------------------------------------------------------------------

# 后台任务 worker 数量
TASK_WORKER_COUNT=2

# 任务队列后端
# memory: 内存队列（默认）
# redis: Redis 队列/状态存储
TASK_QUEUE_BACKEND="memory"

# 内存中保留的任务历史数量
TASK_HISTORY_LIMIT=500

# 任务状态持久化文件
TASK_STATE_FILE="data/task_state.json"

# 任务状态文件中持久化 result 的最大字符数（0 表示不持久化）
TASK_STATE_RESULT_MAX_CHARS=0

# 异步任务上传文件目录
TASK_UPLOAD_DIR="data/task_uploads"

# 异步上传最大大小（字节）
# 默认 50MB，超限统一返回 413
TASK_MAX_UPLOAD_SIZE_BYTES=52428800

# 任务失败后的自动重试次数
TASK_MAX_AUTO_RETRIES=0

# 自动重试前的等待秒数
TASK_RETRY_DELAY_SECONDS=0

# 处理超时回收阈值（秒）
# 仅 Redis 任务后端支持；超过该时间仍处于 processing 的任务会被重新入队
TASK_PROCESSING_TIMEOUT_SECONDS=0

# ----------------------------------------------------------------------------
# 轻量限流配置
# ----------------------------------------------------------------------------

# 是否启用基于 IP + 路由的轻量限流
RATE_LIMIT_ENABLED=true

# 限流窗口内允许的请求数
RATE_LIMIT_REQUESTS=120

# 限流窗口秒数
RATE_LIMIT_WINDOW_SECONDS=60

# 限流桶数量上限，避免高基数路径导致内存无限增长
RATE_LIMIT_MAX_BUCKETS=5000

# 是否信任 Forwarded / X-Forwarded-For 头来识别真实客户端 IP
# 仅在应用部署在你可控的反向代理之后时开启
RATE_LIMIT_TRUST_PROXY_HEADERS=false

# ----------------------------------------------------------------------------
# URL 解析安全配置
# ----------------------------------------------------------------------------

# URL抓取模式
# direct: 直接抓取目标URL并本地转换
# jina_proxy: 通过代理前缀抓取（例如 r.jina.ai）
URL_FETCH_MODE="direct"

# 当 URL_FETCH_MODE=jina_proxy 时使用的代理前缀
URL_PROXY_BASE="https://r.jina.ai/"

# URL抓取超时（秒）
URL_REQUEST_TIMEOUT_SECONDS=30

# URL抓取响应体大小上限（字节）
URL_MAX_RESPONSE_BYTES=5242880

# 是否阻断私网/环回/链路本地地址（建议开启）
URL_BLOCK_PRIVATE_NETWORKS=true

# 可选：域名白名单（逗号分隔，留空表示不过滤）
# URL_ALLOWED_DOMAINS="example.com,docs.example.com"

# 最大重定向次数
URL_MAX_REDIRECTS=3

# ============================================================================
# 配置示例
# ============================================================================

# 示例 1: 高性能GPU配置（推荐）
# PDF_PARSE_ENGINE="vlm-vllm-engine"
# MINERU_DEVICE_MODE="cuda"
# MINERU_MIN_BATCH_INFERENCE_SIZE=512
# MINERU_VIRTUAL_VRAM_SIZE=16384
# VLM_GPU_MEMORY_UTILIZATION=0.9

# 示例 2: CPU模式配置
# PDF_PARSE_ENGINE="pipeline"
# MINERU_DEVICE_MODE="cpu"
# MINERU_MIN_BATCH_INFERENCE_SIZE=128
# MINERU_VIRTUAL_VRAM_SIZE=4096

# 示例 3: 使用远程vLLM服务
# PDF_PARSE_ENGINE="vlm-vllm-client"
# VLM_SERVER_URL="http://localhost:30000"
# VLM_GPU_MEMORY_UTILIZATION=0.9

# 示例 4: 内存受限配置
# PDF_PARSE_ENGINE="pipeline"
# MINERU_DEVICE_MODE="cuda"
# MINERU_VIRTUAL_VRAM_SIZE=4096
# VLM_GPU_MEMORY_UTILIZATION=0.7

# ============================================================================
# 注意事项
# ============================================================================
# 1. GPU模式需要安装CUDA和相应的GPU驱动
# 2. vLLM引擎需要较高的GPU显存（建议16GB+）
# 3. VLM_GPU_MEMORY_UTILIZATION 是vLLM的核心参数，直接影响推理性能
# 4. 首次运行会自动下载模型，请确保网络连接正常
# 5. 修改配置后需要重启服务才能生效
# 6. 建议根据实际GPU显存大小调整VLM_GPU_MEMORY_UTILIZATION值
